# ── Application ──────────────────────────────────────────────
APP_NAME="Social Media Engagement Analyzer"
APP_ENV=production
DEBUG=false

# CORS: include your Vercel deployment domain
ALLOWED_ORIGINS=["https://your-app.vercel.app","http://localhost:5173"]

# ── PostgreSQL (Neon.tech) ───────────────────────────────────
# Option A (recommended): paste Neon's full connection string directly.
# The app normalises postgres:// → postgresql+asyncpg:// and adds ssl=require.
DATABASE_URL=postgresql://neondb_owner:<password>@ep-cool-snowflake-123.us-east-2.aws.neon.tech/neondb?sslmode=require

# Option B: individual components (only used if DATABASE_URL is NOT set)
POSTGRES_USER=neondb_owner
POSTGRES_PASSWORD=
POSTGRES_HOST=ep-cool-snowflake-123.us-east-2.aws.neon.tech
POSTGRES_PORT=5432
POSTGRES_DB=neondb

# ── MongoDB (Atlas M0 Sandbox) ───────────────────────────────
MONGO_URI=mongodb+srv://<username>:<password>@cluster0.example.mongodb.net/?appName=Cluster0
MONGO_DB=engagement_raw

# ── Redis / Celery ───────────────────────────────────────────
# In production (Hugging Face Spaces / Render) Redis runs INSIDE the container
# on localhost:6379.  No external Redis (Upstash) is required.
REDIS_URL=redis://127.0.0.1:6379/0
CELERY_BROKER_URL=redis://127.0.0.1:6379/1
CELERY_RESULT_BACKEND=redis://127.0.0.1:6379/2

# ── YouTube Data API v3 ─────────────────────────────────────
YOUTUBE_API_KEY=your_youtube_api_key_here
YOUTUBE_CACHE_TTL=3600
YOUTUBE_DAILY_QUOTA_LIMIT=10000
YOUTUBE_QUOTA_SAFETY_BUFFER=500

# ── Reddit API (PRAW) ───────────────────────────────────────
REDDIT_CLIENT_ID=your_reddit_client_id_here
REDDIT_CLIENT_SECRET=your_reddit_client_secret_here
REDDIT_USER_AGENT=EngageLens/3.0 by u/YourRedditUsername
REDDIT_RATE_LIMIT_CALLS_PER_MIN=60

# ── River.ai API (Chatbot) ─────────────────────────────────────────────────
# Get your key at https://river.ai → Dashboard → API Keys
RIVER_API_KEY=your_river_api_key_here
RIVER_MODEL=deepseek-ai/DeepSeek-V4.1-Flash

# ── Semantic matching ──────────────────────────────────────
SEMANTIC_SIMILARITY_THRESHOLD=0.55
SEMANTIC_EMBEDDING_MODEL=all-MiniLM-L6-v2

# ── Vercel Frontend ────────────────────────────────────────
# Set this in Vercel Project Settings → Environment Variables
# VITE_API_BASE=https://your-app.hf.space
