# ── Application ──────────────────────────────────────────────
APP_NAME="Social Media Engagement Analyzer"
APP_ENV=development
DEBUG=true

# ── PostgreSQL ───────────────────────────────────────────────
POSTGRES_USER=postgres
POSTGRES_PASSWORD=
POSTGRES_HOST=localhost
POSTGRES_PORT=5432
POSTGRES_DB=postgres

# ── MongoDB ──────────────────────────────────────────────────
MONGO_URI=mongodb+srv://<username>:<password>@cluster0.example.mongodb.net/?appName=Cluster0
MONGO_DB=engagement_raw

# ── Redis / Celery ───────────────────────────────────────────
REDIS_URL=redis://localhost:6379/0
CELERY_BROKER_URL=redis://localhost:6379/1
CELERY_RESULT_BACKEND=redis://localhost:6379/2

# ── YouTube Data API v3 ─────────────────────────────────────
YOUTUBE_API_KEY=your_youtube_api_key_here


# ── Reddit API (PRAW) ───────────────────────────────────────
REDDIT_CLIENT_ID=your_reddit_client_id_here
REDDIT_CLIENT_SECRET=your_reddit_client_secret_here
REDDIT_USER_AGENT=EngageLens/3.0 by u/YourRedditUsername

# ── Groq Cloud LLM ─────────────────────────────────────────────────────────
GROQ_API_KEY=your_groq_api_key_here
