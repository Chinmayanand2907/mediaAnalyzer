# ── Application ──────────────────────────────────────────────
APP_NAME="Social Media Engagement Analyzer"
APP_ENV=development
DEBUG=false
ALLOWED_ORIGINS=["http://localhost:3000","http://localhost:5173","http://127.0.0.1:3000","http://127.0.0.1:5173"]

# ── PostgreSQL ───────────────────────────────────────────────
POSTGRES_USER=postgres
POSTGRES_PASSWORD=
POSTGRES_HOST=localhost
POSTGRES_PORT=5432
POSTGRES_DB=postgres

# ── MongoDB ──────────────────────────────────────────────────
MONGO_URI=mongodb+srv://<username>:<password>@cluster0.example.mongodb.net/?appName=Cluster0
MONGO_DB=engagement_raw

# ── Redis / Celery ───────────────────────────────────────────
REDIS_URL=redis://localhost:6379/0
CELERY_BROKER_URL=redis://localhost:6379/1
CELERY_RESULT_BACKEND=redis://localhost:6379/2

# ── YouTube Data API v3 ─────────────────────────────────────
YOUTUBE_API_KEY=your_youtube_api_key_here
YOUTUBE_CACHE_TTL=3600
YOUTUBE_DAILY_QUOTA_LIMIT=10000
YOUTUBE_QUOTA_SAFETY_BUFFER=500


# ── Reddit API (PRAW) ───────────────────────────────────────
REDDIT_CLIENT_ID=your_reddit_client_id_here
REDDIT_CLIENT_SECRET=your_reddit_client_secret_here
REDDIT_USER_AGENT=EngageLens/3.0 by u/YourRedditUsername
REDDIT_RATE_LIMIT_CALLS_PER_MIN=60

# ── Gemini API (Chatbot) ──────────────────────────────────────────────────
GEMINI_API_KEY=your_gemini_api_key_here
GEMINI_MODEL=gemini-2.5-flash-lite

# ── Semantic matching ──────────────────────────────────────
SEMANTIC_SIMILARITY_THRESHOLD=0.55
SEMANTIC_EMBEDDING_MODEL=all-MiniLM-L6-v2

